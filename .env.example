# API URLs - Choisir l'URL appropriée selon l'environnement
# Développement local
REACT_APP_API_URL=http://localhost:4000  # URL du serveur de développement local

# Staging (GitHub Codespaces)
# REACT_APP_API_URL=https://miniature-space-spoon-xgjj5v7wq562vgp4-4000.app.github.dev  # URL du serveur de staging

# Production
# REACT_APP_API_URL=https://micmarket-back.vercel.app  # URL du serveur de production

# Configuration WebSocket pour le développement
WDS_SOCKET_PORT=0  # Désactive le port WebSocket par défaut pour GitHub Codespaces

# Authentication
REACT_APP_AUTH_ROLE=user  # Role par défaut (admin, user, startup)
REACT_APP_JWT_SECRET=your_jwt_secret_here  # Clé secrète pour JWT

# External Services
REACT_APP_RAWG_API_KEY=your_rawg_api_key_here  # Clé API pour le service externe RAWG

# Ne pas commiter le vrai fichier .env, utiliser ce fichier comme modèle
# Copier ce fichier vers .env et remplir avec les vraies valeurs